{
  "$schema": "harnessgram-house-tokens/1",
  "name": "Harnessgram — The House",
  "version": "1.0.0",
  "date": "2026-11-15",
  "notes": "Design tokens for the Harnessgram 'The House' identity. Values in pt for iOS (1pt = 1px on the web page). Light theme name 'אבן' (stone), dark theme name 'לילה' (night). Contrast pairs checked to WCAG AA for text (4.5:1) unless marked 'large'.",
  "color": {
    "light": {
      "bg":            { "value": "#F4EDE2", "use": "app background, limestone" },
      "bgStoneTexture":{ "value": "asset:texture-stone-light", "use": "optional subtle stone texture at 6% over bg" },
      "surface":       { "value": "#FBF7F0", "use": "cards, room card text panel" },
      "surfaceRaised": { "value": "#FFFDF9", "use": "sheets, knock, popovers" },
      "border":        { "value": "#E3D6C2", "use": "hairlines, card outline" },
      "borderStrong":  { "value": "#CDBA9C", "use": "arch frame lines, focused field" },
      "ink":           { "value": "#2A2118", "use": "primary text" },
      "ink2":          { "value": "#5E4F3E", "use": "secondary text" },
      "ink3":          { "value": "#74644F", "use": "tertiary text, timestamps" },
      "cedar":         { "value": "#7A4E2D", "use": "radio bar wood, brand accents" },
      "cedarDeep":     { "value": "#56361F", "use": "radio bar edge, pressed" },
      "brass":         { "value": "#B08A3E", "use": "hardware details, dividers on wood" },
      "amber":         { "value": "#E9A23B", "use": "lamplight, waiting state, progress fill" },
      "amberGlow":     { "value": "#F6C76A", "use": "glow behind lit windows (with alpha)" },
      "amberDeep":     { "value": "#A85A1A", "use": "waiting count badge background, white text on it" },
      "olive":         { "value": "#55683A", "use": "primary action buttons, outgoing message bubble" },
      "oliveDeep":     { "value": "#3F4F2A", "use": "pressed primary" },
      "onOlive":       { "value": "#FBF7F0", "use": "text on olive" },
      "statusWorking": { "value": "#5FA83A", "use": "agent working dot" },
      "statusIdle":    { "value": "#B9AE9C", "use": "idle dot" },
      "statusWaiting": { "value": "#E9A23B", "use": "waiting for you dot" },
      "statusError":   { "value": "#B5452F", "use": "stuck / failed, brick red" },
      "scrim":         { "value": "rgba(42,33,24,0.45)", "use": "behind the knock sheet" }
    },
    "dark": {
      "bg":            { "value": "#14110E", "use": "night stone" },
      "surface":       { "value": "#1F1A15", "use": "cards" },
      "surfaceRaised": { "value": "#28221B", "use": "sheets" },
      "border":        { "value": "#3A3128", "use": "hairlines" },
      "borderStrong":  { "value": "#56493B", "use": "arch frame lines" },
      "ink":           { "value": "#F3EADB", "use": "primary text" },
      "ink2":          { "value": "#C7B8A2", "use": "secondary text" },
      "ink3":          { "value": "#968670", "use": "tertiary text" },
      "cedar":         { "value": "#8A5A36", "use": "radio bar wood" },
      "cedarDeep":     { "value": "#5E3B22", "use": "radio edge" },
      "brass":         { "value": "#C9A257", "use": "hardware" },
      "amber":         { "value": "#F2B24C", "use": "lamplight, progress" },
      "amberGlow":     { "value": "#FFD27A", "use": "lit window glow, stronger at night (alpha 0.45)" },
      "amberDeep":     { "value": "#D07A2A", "use": "badge background, dark text #14110E on it" },
      "olive":         { "value": "#8FA866", "use": "primary action (dark text on it)" },
      "oliveDeep":     { "value": "#768D50", "use": "pressed" },
      "onOlive":       { "value": "#14110E", "use": "text on olive" },
      "statusWorking": { "value": "#7CC653", "use": "working dot" },
      "statusIdle":    { "value": "#6E6355", "use": "idle dot" },
      "statusWaiting": { "value": "#F2B24C", "use": "waiting dot" },
      "statusError":   { "value": "#D9654B", "use": "stuck" },
      "scrim":         { "value": "rgba(0,0,0,0.6)", "use": "behind the knock sheet" }
    },
    "liveSurfaces": {
      "notes": "Lock screen, Live Activity, Dynamic Island and CarPlay use B's compact instrument layout in House colours: dark glass, amber progress, olive done.",
      "glass":    { "value": "rgba(31,26,21,0.78)" },
      "progress": { "value": "#F2B24C" },
      "done":     { "value": "#8FA866" },
      "track":    { "value": "rgba(243,234,219,0.18)" },
      "text":     { "value": "#F3EADB" }
    }
  },
  "font": {
    "family": {
      "display": "Frank Ruhl Libre",
      "body": "Assistant",
      "ui": "Heebo",
      "numeric": "Rubik"
    },
    "notes": "All four fonts ship in build 11 (HarnessgramFonts). Numbers and times use Rubik with tabular figures. Reading view uses Assistant 18/30, justified, from build 11's justified text.",
    "scale": {
      "display":   { "family": "display", "size": 34, "weight": 700, "lineHeight": 40, "use": "home greeting" },
      "title1":    { "family": "display", "size": 28, "weight": 700, "lineHeight": 34, "use": "room title, sheet title" },
      "title2":    { "family": "display", "size": 22, "weight": 700, "lineHeight": 28, "use": "room card name, section title" },
      "title3":    { "family": "display", "size": 20, "weight": 500, "lineHeight": 26, "use": "pull-quote question in reading view" },
      "headline":  { "family": "body", "size": 17, "weight": 700, "lineHeight": 24, "use": "row titles, byline" },
      "body":      { "family": "body", "size": 17, "weight": 400, "lineHeight": 26, "use": "general text" },
      "reading":   { "family": "body", "size": 18, "weight": 400, "lineHeight": 30, "use": "agent reports, justified" },
      "callout":   { "family": "body", "size": 15, "weight": 600, "lineHeight": 22, "use": "card sub-line, chips" },
      "button":    { "family": "ui",   "size": 17, "weight": 600, "lineHeight": 22, "use": "buttons" },
      "caption":   { "family": "numeric", "size": 13, "weight": 500, "lineHeight": 18, "use": "times, counts, labels" },
      "badge":     { "family": "numeric", "size": 15, "weight": 700, "lineHeight": 18, "use": "waiting count" }
    },
    "dynamicType": "Scale all sizes with UIFontMetrics; cards grow in height, never truncate room names below 2 lines."
  },
  "space": {
    "base": 4,
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32,
    "gutterPhone": 16,
    "gutterTablet": 24,
    "cardPadding": 14,
    "cardGap": 12,
    "sectionGap": 24,
    "radioBarInset": 12,
    "minTapTarget": 44,
    "safeArea": "respect top, bottom and home-indicator insets; radio bar sits 8pt above the tab bar"
  },
  "radius": {
    "card": 20,
    "roomArt": 16,
    "button": 14,
    "chip": 999,
    "sheetTop": 28,
    "radioBar": 22,
    "archTop": "50% of width (semicircle)",
    "windowArch": "50% of width (semicircle) on a 0.75 width:height opening"
  },
  "shape": {
    "arch": "Semicircular arch over straight jambs. Used by: the waiting doorway card (full-width arch, 140pt tall on phone), room art niches, the knock sheet top edge (shallow arch, 24pt rise), lit-window status, empty states and the app icon.",
    "noCrosses": "No plus or cross shapes in any asset or icon: windows without panes, no crosshair, add buttons use a door or arrow glyph instead of '+'."
  },
  "shadow": {
    "light": {
      "card":   "0 1 2 rgba(60,40,20,0.08), 0 6 16 rgba(60,40,20,0.10)",
      "sheet":  "0 -8 32 rgba(60,40,20,0.18)",
      "radio":  "0 6 18 rgba(86,54,31,0.30)"
    },
    "dark": {
      "card":   "0 0 0 1 #3A3128",
      "sheet":  "0 -8 32 rgba(0,0,0,0.5)",
      "litGlow":"0 0 24 rgba(242,178,76,0.35)"
    }
  },
  "motion": {
    "reduceMotion": "replace every movement with a 150ms fade",
    "windowLightOn":  { "duration": 400, "curve": "easeOut", "what": "room window opacity 0.35->1 plus amber glow" },
    "windowLightOff": { "duration": 600, "curve": "easeInOut" },
    "enterRoom":      { "duration": 350, "curve": "spring(damping 0.85)", "what": "card art expands into the room header (matched geometry)" },
    "knock":          { "duration": 320, "curve": "spring(damping 0.8)", "what": "two light haptic taps, then the knock sheet rises" },
    "badgePulse":     { "duration": 1200, "curve": "easeInOut", "what": "doorway lantern glow breathes while items wait; stops after 3 cycles" },
    "radioWave":      { "duration": 900, "curve": "linear loop", "what": "three amber arcs above the radio while playing" },
    "progressFill":   { "duration": 500, "curve": "easeOut" }
  },
  "icon": {
    "appIcon": "assets/app-icon.png (1024x1024, full bleed, iOS mask applied by the system)",
    "glyphs": "SF Symbols in the ink colour; custom glyphs: lantern (agent avatar), door-knocker (knock), wooden radio (radio)."
  }
}
